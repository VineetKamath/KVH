# Copy to .env. Never commit .env.
# ADMIN_TOKEN is generated by `python -m scripts.seed` if absent (>= 32 random bytes, url-safe).
ADMIN_TOKEN=
# LLM: "offline" (default, deterministic templates) or "anthropic" (live Claude; needs ANTHROPIC_API_KEY)
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
# The web origin allowed by CORS in dev (Vite). In production the API serves the UI on the same origin.
WEB_ORIGIN=http://localhost:5173
# Optional automatic reprice every N minutes (0 = off; the demo uses the Advance-day control)
AUTO_REPRICE_MINUTES=0
